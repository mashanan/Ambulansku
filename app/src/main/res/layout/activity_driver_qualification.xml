<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lengkapi Data Kualifikasi Driver"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFormSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data ini akan diperiksa Admin sebelum akun Anda disetujui untuk mengemudi."
            android:textColor="#757575"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- ===================== STANDAR 1 ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standar 1: Legalitas &amp; Lisensi Lalu Lintas"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nomor SIM A"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLicenseNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto SIM A (wajib)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgLicensePreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="Preview Foto SIM" />

        <Button
            android:id="@+id/btnPickLicensePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Foto SIM"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nomor Plat / STNK"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmbulancePlate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto STNK (wajib)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgStnkPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="Preview Foto STNK" />

        <Button
            android:id="@+id/btnPickStnkPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Foto STNK"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto Kondisi Ambulans (wajib, minimal 1)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/containerAmbulancePhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnAddAmbulancePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Foto Ambulans"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sertifikat Ambulance Emergency Driving (opsional)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgAedPreview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="Preview Sertifikat AED"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPickAedCert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Foto Sertifikat AED (opsional)"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- ===================== STANDAR 2 ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standar 2: Kompetensi Medis Dasar"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sertifikat BTLS atau BHD (opsional)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgMedicalPreview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="Preview Sertifikat BTLS/BHD"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPickMedicalCert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Foto Sertifikat BTLS/BHD (opsional)"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- ===================== STANDAR 3 ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standar 3: Etika &amp; Protokol Operasional (SOP)"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Centang semua pernyataan berikut untuk melanjutkan pendaftaran."
            android:textColor="#757575"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbSopSirine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saya memahami etika dan peraturan penggunaan sirine"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbSopEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saya menguasai penggunaan alat utama ambulans (tabung oksigen, kelistrikan/inverter, kebersihan unit)"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbSopApd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saya mengerti cara penggunaan Alat Pelindung Diri (APD) dasar (sarung tangan lateks, masker medis, sepatu keselamatan)"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbSopHealthCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saya telah lolos tes kesehatan berkala (bebas narkoba, pendengaran baik, penglihatan baik)"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#D32F2F"
            android:textColor="@android:color/white"
            android:text="Kirim untuk Verifikasi"
            android:textAllCaps="false"
            android:enabled="false"
            android:alpha="0.5"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
