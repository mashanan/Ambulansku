<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete Driver Qualification Data"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFormSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This data will be reviewed by the Admin before your account is approved to drive."
            android:textColor="#757575"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- ===================== STANDAR 1 ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard 1: Legal Documents &amp; Traffic License"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Driver's License Number (SIM A)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLicenseNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver's License Photo (required)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgLicensePreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="Driver's License Photo Preview" />

        <Button
            android:id="@+id/btnPickLicensePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose License Photo"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plate Number / Vehicle Registration"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmbulancePlate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ambulance Category"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerAmbulanceCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Penjelasan kategori yang sedang dipilih - diperbarui otomatis saat pilihan berubah -->
        <TextView
            android:id="@+id/tvAmbulanceCategoryDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text=""
            android:textColor="#757575"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Registration Photo (required)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgStnkPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="Vehicle Registration Photo Preview" />

        <Button
            android:id="@+id/btnPickStnkPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Registration Photo"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ambulance Condition Photos (required, at least 1)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/containerAmbulancePhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnAddAmbulancePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ambulance Photo"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ambulance Emergency Driving Certificate (optional)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgAedPreview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="AED Certificate Preview"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPickAedCert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose AED Certificate Photo (optional)"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- ===================== STANDAR 2 ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard 2: Basic Medical Competency"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BTLS or BHD Certificate (optional)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgMedicalPreview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="BTLS/BHD Certificate Preview"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPickMedicalCert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose BTLS/BHD Certificate Photo (optional)"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- ===================== STANDAR 3 ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard 3: Ethics &amp; Operational Protocol (SOP)"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check all the following statements to continue your registration."
            android:textColor="#757575"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbSopSirine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I understand the ethics and regulations for siren use"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbSopEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I am proficient in using the ambulance's main equipment (oxygen tank, electrical/inverter system, unit cleanliness)"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbSopApd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I understand how to use basic Personal Protective Equipment (PPE) (latex gloves, medical mask, safety shoes)"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbSopHealthCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I have passed regular health checks (drug-free, good hearing, good eyesight)"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#D32F2F"
            android:textColor="@android:color/white"
            android:text="Submit for Verification"
            android:textAllCaps="false"
            android:enabled="false"
            android:alpha="0.5"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
