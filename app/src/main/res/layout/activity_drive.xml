<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ForPassenger.DriveFragment.ActivityDrive">

    <!-- Google Maps Fragment - selalu penuh layar, tidak lagi tertutup permanen oleh panel info -->
    <fragment
        android:id="@+id/mapview"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 💬 Tombol Chat - posisi tetap di kanan atas peta, tidak ikut naik-turun bersama
         panel bawah supaya selalu gampang dijangkau apa pun posisi panel-nya -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnChatDriver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_dialog_email"
            android:visibility="gone"
            app:backgroundTint="#0084FF"
            app:tint="@android:color/white"
            android:contentDescription="Chat Driver" />

        <!-- 🔴 Angka Notif Merah (Badge) untuk Passenger -->
        <TextView
            android:id="@+id/tvUnreadBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge_red"
            android:gravity="center"
            android:text="1"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:elevation="10dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Panel Informasi Pemesanan & Penjemputan, sekarang bottom sheet yang bisa ditarik turun
         (mengecil, cuma sisakan handle + judul, memaksimalkan tampilan peta) atau ditarik naik
         (tampil penuh) kapan saja oleh user. Sengaja TIDAK hideable penuh (behavior_hideable
         di-omit/false) supaya selalu ada handle tersisa untuk ditarik kembali - kalau
         disembunyikan total, user tidak akan punya cara menariknya lagi. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOrderInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="84dp"
        app:behavior_fitToContents="true"
        app:cardElevation="10dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BottomSheetTop">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Pegangan drag -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_drag_handle" />

            <TextView
                android:id="@+id/tvDestinationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearest Hospital"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvDestinationAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detecting hospital location..."
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- Jarak & estimasi waktu tempuh dari Directions API, ditampilkan selalu terlihat
                 di atas tombol (beda dari tvEstimationInfo yang cuma tampil setelah pesanan diterima driver) -->
            <TextView
                android:id="@+id/tvDestinationEstimation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Calculating distance &amp; travel time..."
                android:textColor="@color/pink_main"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPesanAmbulans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Call Ambulance Now"
                android:backgroundTint="#D32F2F"
                android:textColor="@android:color/white"
                android:padding="12dp"
                android:textAllCaps="false" />

            <LinearLayout
                android:id="@+id/layoutDriverOnTheWay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="8dp" />

                <!-- 🚑 Info Driver: supaya passenger bisa konfirmasi driver saat bertemu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivDriverPhoto"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/foto_profil"
                        app:civ_border_color="#80FF624E"
                        app:civ_border_width="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDriverName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Driver Name"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDriverPlate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Plate: -"
                            android:textColor="#757575"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnCallDriver"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="#2E7D32"
                        android:contentDescription="Call Driver"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_call"
                        app:tint="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDriverStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ambulance Is Heading to Your Location"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstimationInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated arrival: Calculating..."
                    android:textColor="#757575"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <!-- 🚑 Stepper progres perjalanan: pembacaan visual dari status booking yang
                     sudah dilacak listenDriverResponse(), bukan sumber data baru. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/stepCircle1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_step_circle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Picked Up"
                            android:textColor="#757575"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/stepConnector1"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:layout_marginBottom="14dp"
                        android:background="#E0E0E0" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/stepCircle2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_step_circle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="En Route"
                            android:textColor="#757575"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/stepConnector2"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:layout_marginBottom="14dp"
                        android:background="#E0E0E0" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/stepCircle3"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_step_circle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Completed"
                            android:textColor="#757575"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
