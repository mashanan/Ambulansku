<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ForPassenger.ActivityDrive">

    <!-- Google Maps Fragment -->
    <fragment
        android:id="@+id/mapview"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search Bar -->
    <EditText
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Cari Lokasi..."
        android:padding="12dp"
        android:elevation="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/search_view_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 💬 Tombol Chat (Melayang di kanan bawah peta) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnChatDriver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_dialog_email"
        android:visibility="gone"
        app:backgroundTint="#0084FF"
        app:tint="@android:color/white"
        android:contentDescription="Chat Driver"
        app:layout_constraintBottom_toTopOf="@id/cardOrderInfo"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔴 Angka Notif Merah (Badge) untuk Passenger -->
    <TextView
        android:id="@+id/tvUnreadBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_badge_red"
        android:gravity="center"
        android:text="1"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/btnChatDriver"
        app:layout_constraintEnd_toEndOf="@id/btnChatDriver" />

    <!-- Card Informasi Pemesanan & Penjemputan -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOrderInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDestinationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rumah Sakit Terdekat"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvDestinationAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mendeteksi lokasi RS..."
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnPesanAmbulans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Panggil Ambulans Sekarang"
                android:backgroundTint="#D32F2F"
                android:textColor="@android:color/white"
                android:padding="12dp"
                android:textAllCaps="false" />

            <LinearLayout
                android:id="@+id/layoutDriverOnTheWay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="8dp" />

                <!-- 🚑 Info Driver: supaya passenger bisa konfirmasi driver saat bertemu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivDriverPhoto"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/foto_profil"
                        app:civ_border_color="#80FF624E"
                        app:civ_border_width="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDriverName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nama Driver"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDriverPlate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Plat: -"
                            android:textColor="#757575"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnCallDriver"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="#2E7D32"
                        android:contentDescription="Telepon Driver"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_call"
                        app:tint="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDriverStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ambulans Sedang Menuju Lokasi Anda"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstimationInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimasi waktu tiba: Menghitung..."
                    android:textColor="#757575"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>