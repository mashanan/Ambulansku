<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/v2_border_default"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvHospitalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RSUD Dr. Soetomo"
            android:textAppearance="@style/TextAppearance.V2.H3" />

        <TextView
            android:id="@+id/tvHospitalAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Jl. Mayjen Prof. Dr. Moestopo No. 6-8, Surabaya"
            android:textColor="@color/v2_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHospitalPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="(031) 5501078"
            android:textAppearance="@style/TextAppearance.V2.Caption"
            android:textColor="@color/v2_text_tertiary" />

        <TextView
            android:id="@+id/tvMissingLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_v2_pill"
                android:backgroundTint="@color/v2_warning_soft"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Location not set"
            android:textColor="@color/v2_warning"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditHospital"
                style="@style/Widget.V2.Button.Secondary.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Edit"
                app:icon="@drawable/ic_v2_pencil" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteHospital"
                style="@style/Widget.V2.Button.Danger.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delete"
                app:icon="@drawable/ic_v2_trash" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
