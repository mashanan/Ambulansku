<?xml version="1.0" encoding="utf-8"?>
<!-- v2 First Aid Item (Figma component "First Aid Item"). IDs unchanged (FirstAidAdapter). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.V2.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                style="@style/Widget.V2.IconBox"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/v2_danger_soft"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_v2_first_aid"
                app:tint="@color/v2_danger" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Condition Name"
                    android:textAppearance="@style/TextAppearance.V2.H3" />

                <TextView
                    android:id="@+id/tvSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Symptoms"
                    android:textAppearance="@style/TextAppearance.V2.Caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExpandArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="@color/v2_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_v2_round_md"
            android:backgroundTint="@color/v2_bg_canvas"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="First aid steps"
                android:textAppearance="@style/TextAppearance.V2.Overline" />

            <TextView
                android:id="@+id/tvSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Steps"
                android:textAppearance="@style/TextAppearance.V2.Body" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
