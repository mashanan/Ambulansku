<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Chat Room (Figma: P13). Shared by ChatPassengerActivity and ChatDriverActivity;
     all view IDs/types are unchanged. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_canvas"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_v2_divider_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/btnBackPassengerChat"
            style="@style/Widget.V2.CircleButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_v2_arrow_left" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivContactPhoto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/foto_profil"
            app:civ_border_color="@color/v2_brand_soft_strong"
            app:civ_border_width="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ambulance Driver"
                android:textAppearance="@style/TextAppearance.V2.BodyStrong" />

            <TextView
                android:id="@+id/tvDriverStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Heading to your location"
                android:textAppearance="@style/TextAppearance.V2.Caption"
                android:textColor="@color/v2_success" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCallContact"
            style="@style/Widget.V2.CircleButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/v2_brand"
            android:contentDescription="Call"
            android:padding="10dp"
            android:src="@drawable/ic_v2_phone"
            android:visibility="gone"
            app:tint="@color/v2_text_on_brand" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistoryExpiryNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_v2_pill"
        android:backgroundTint="@color/v2_bg_subtle"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="This chat history will be hidden on ..."
        android:textAppearance="@style/TextAppearance.V2.Caption"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPassengerChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomInput"
        android:layout_below="@id/tvHistoryExpiryNotice"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp" />

    <!-- Composer: quick replies + input -->
    <LinearLayout
        android:id="@+id/layoutBottomInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_v2_divider_top"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupQuickChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip1"
                    style="@style/Widget.V2.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I'm already at the location" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip2"
                    style="@style/Widget.V2.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The patient is in an emergency!" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip3"
                    style="@style/Widget.V2.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Is the driver nearby yet?" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip4"
                    style="@style/Widget.V2.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The patient is ready to be picked up" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnAttachPhoto"
                style="@style/Widget.V2.CircleButton"
                android:contentDescription="Attach photo"
                android:src="@drawable/ic_v2_camera"
                app:tint="@color/v2_text_secondary" />

            <EditText
                android:id="@+id/etChatMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_pill_outline"
                android:hint="Type a message…"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textAppearance="@style/TextAppearance.V2.Body"
                android:textColorHint="@color/v2_text_tertiary" />

            <ImageView
                android:id="@+id/btnSendPassengerChat"
                style="@style/Widget.V2.CircleButton"
                android:backgroundTint="@color/v2_brand"
                android:contentDescription="Send"
                android:src="@drawable/ic_v2_send"
                app:tint="@color/v2_text_on_brand" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
