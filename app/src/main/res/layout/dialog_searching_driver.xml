<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Searching Driver dialog (Figma: P09). IDs unchanged (ActivityDrive.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="312dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/v2_bg_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Pulse: soft coral halo, spinner ring and ambulance icon -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_v2_circle"
                android:backgroundTint="@color/v2_brand_soft">

                <ProgressBar
                    android:id="@+id/pbSearching"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/v2_brand_accent" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_v2_circle"
                    android:backgroundTint="@color/v2_brand"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:src="@drawable/ic_v2_ambulance"
                    app:tint="@color/v2_text_on_brand" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Finding the nearest driver…"
                android:textAppearance="@style/TextAppearance.V2.H2" />

            <TextView
                android:id="@+id/tvSearchingDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Please wait a moment, the system is connecting you with the nearest driver."
                android:textAppearance="@style/TextAppearance.V2.Body.Secondary" />

            <TextView
                android:id="@+id/tvElapsedTime"
                style="@style/Widget.V2.Badge.Neutral"
                android:layout_marginTop="12dp"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:text="0 seconds elapsed"
                app:drawableStartCompat="@drawable/ic_v2_clock"
                app:drawableTint="@color/v2_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_v2_round_md"
                android:backgroundTint="@color/v2_warning_soft"
                android:drawablePadding="10dp"
                android:padding="12dp"
                android:text="While waiting, keep the patient calm and check the First Aid guide on the Home screen."
                android:textAppearance="@style/TextAppearance.V2.Caption"
                android:textColor="@color/v2_warning"
                app:drawableStartCompat="@drawable/ic_v2_first_aid"
                app:drawableTint="@color/v2_warning" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshSearch"
                style="@style/Widget.V2.Button.Secondary.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Search again"
                android:visibility="gone"
                app:icon="@drawable/ic_v2_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSearch"
                style="@style/Widget.V2.Button.Danger.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cancel booking"
                app:icon="@drawable/ic_v2_x" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
