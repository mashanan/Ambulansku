<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Hospital Card (Figma component "Hospital Card"). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.V2.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            style="@style/Widget.V2.IconBox"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_v2_hospital" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHospitalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RSUD Dr. Soetomo"
                android:textAppearance="@style/TextAppearance.V2.H3" />

            <TextView
                android:id="@+id/tvHospitalAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jl. Mayjen Prof. Dr. Moestopo No. 6-8, Surabaya"
                android:textAppearance="@style/TextAppearance.V2.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Distance & ETA from the passenger, only shown once calculated -->
                <LinearLayout
                    android:id="@+id/layoutHospitalDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHospitalDistance"
                        style="@style/Widget.V2.Badge.Info"
                        android:text="3.2 km • ~12 min" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHospitalPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:text="(031) 5501078"
                    android:textAppearance="@style/TextAppearance.V2.Caption"
                    android:textColor="@color/v2_text_tertiary"
                    app:drawableStartCompat="@drawable/ic_v2_phone"
                    app:drawableTint="@color/v2_text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_v2_chevron_right"
            app:tint="@color/v2_text_tertiary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
