<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Passenger Chat List (Figma: P12). IDs unchanged (ChatFragment.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:text="Messages"
        android:textAppearance="@style/TextAppearance.V2.H1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="20dp"
        android:text="Chat with your ambulance driver"
        android:textAppearance="@style/TextAppearance.V2.Body.Secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_v2_round_md"
        android:backgroundTint="@color/v2_bg_canvas"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="Chats are hidden some time after a trip ends."
        android:textAppearance="@style/TextAppearance.V2.Caption"
        app:drawableStartCompat="@drawable/ic_v2_clock"
        app:drawableTint="@color/v2_text_tertiary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPassengerChatList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_passenger_chat" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/layoutEmptyChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_v2_circle"
                android:backgroundTint="@color/v2_bg_subtle"
                android:importantForAccessibility="no"
                android:padding="20dp"
                android:src="@drawable/ic_v2_chat"
                app:tint="@color/v2_text_tertiary" />

            <TextView
                android:id="@+id/tvEmptyChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No conversation history yet"
                android:textAppearance="@style/TextAppearance.V2.H3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="When a driver accepts your booking, you can chat with them here."
                android:textAppearance="@style/TextAppearance.V2.Caption" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
