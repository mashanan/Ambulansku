<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Driver Trip map: full-screen map + draggable bottom sheet with status, passenger card,
     trip stepper and actions. All IDs/types used by ActivityDriveFragmentDriver.kt are unchanged. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_canvas">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnChatPassenger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:contentDescription="Chat with passenger"
            android:src="@drawable/ic_v2_chat"
            android:visibility="gone"
            app:backgroundTint="@color/v2_brand"
            app:tint="@color/v2_text_on_brand"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvUnreadBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_v2_circle"
            android:backgroundTint="@color/v2_danger"
            android:elevation="10dp"
            android:gravity="center"
            android:text="1"
            android:textAppearance="@style/TextAppearance.V2.Overline"
            android:textColor="@color/v2_text_on_brand"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_fitToContents="true"
        app:behavior_peekHeight="88dp"
        app:cardBackgroundColor="@color/v2_bg_surface"
        app:cardElevation="12dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BottomSheetTop"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_v2_handle" />

            <!-- Current status: the only line still visible when the sheet is collapsed -->
            <TextView
                android:id="@+id/tvCurrentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to accept bookings..."
                android:textAppearance="@style/TextAppearance.V2.H2" />

            <TextView
                android:id="@+id/tvEstimationInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.V2.Caption" />

            <!-- Passenger card -->
            <LinearLayout
                android:id="@+id/layoutPassengerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_v2_round_lg"
                android:backgroundTint="@color/v2_bg_canvas"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivPassengerPhoto"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/foto_profil"
                    app:civ_border_color="@color/v2_brand_soft_strong"
                    app:civ_border_width="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPassengerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Passenger Name"
                        android:textAppearance="@style/TextAppearance.V2.BodyStrong" />

                    <TextView
                        android:id="@+id/tvPassengerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnCallPassenger"
                    style="@style/Widget.V2.CircleButton"
                    android:backgroundTint="@color/v2_brand"
                    android:contentDescription="Call passenger"
                    android:src="@drawable/ic_v2_phone"
                    app:tint="@color/v2_text_on_brand" />
            </LinearLayout>

            <!-- Trip stepper, colored by ActivityDriveFragmentDriver -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/stepCircle1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_v2_circle"
                        android:backgroundTint="@color/v2_bg_subtle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Pickup"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <View
                    android:id="@+id/stepConnector1"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1"
                    android:background="@color/v2_bg_subtle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/stepCircle2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_v2_circle"
                        android:backgroundTint="@color/v2_bg_subtle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="To hospital"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <View
                    android:id="@+id/stepConnector2"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1"
                    android:background="@color/v2_bg_subtle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/stepCircle3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_v2_circle"
                        android:backgroundTint="@color/v2_bg_subtle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Done"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelesai"
                style="@style/Widget.V2.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Confirm Pickup"
                android:visibility="gone"
                app:icon="@drawable/ic_v2_check" />

            <!-- Only in "to hospital" mode: redirect to a better-equipped hospital in an emergency -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGantiRumahSakit"
                style="@style/Widget.V2.Button.Tertiary.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Change to another hospital (emergency)"
                android:visibility="gone"
                app:icon="@drawable/ic_v2_hospital" />

            <!-- Deliberately a plain text button (the code asks for 2 confirmations) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatalkanPesanan"
                style="@style/Widget.V2.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cancel booking (emergency)"
                android:textColor="@color/v2_danger"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
