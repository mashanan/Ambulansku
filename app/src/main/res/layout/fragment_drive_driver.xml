<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🗺️ Google Map - selalu penuh layar, tidak lagi tertutup permanen oleh panel info -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 💬 Tombol Chat - posisi tetap di kanan atas peta, tidak ikut naik-turun bersama
         panel bawah supaya selalu gampang dijangkau apa pun posisi panel-nya -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnChatPassenger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_dialog_email"
            android:visibility="gone"
            app:backgroundTint="#0084FF"
            app:tint="@android:color/white"
            android:contentDescription="Passenger Chat" />

        <!-- 🔴 Angka Notif Merah (Badge) untuk Driver -->
        <TextView
            android:id="@+id/tvUnreadBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge_red"
            android:gravity="center"
            android:text="1"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:elevation="10dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 📋 Panel Info Jarak & Tombol Selesai - sekarang bottom sheet yang bisa ditarik turun
         (mengecil, cuma sisakan handle + status pesanan saat ini, memaksimalkan tampilan peta)
         atau ditarik naik (tampil penuh) kapan saja oleh driver. Sengaja TIDAK hideable penuh
         supaya selalu ada handle tersisa untuk ditarik kembali. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="72dp"
        app:behavior_fitToContents="true"
        app:cardElevation="10dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BottomSheetTop">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Pegangan drag -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_drag_handle" />

            <!-- Status pesanan saat ini - satu-satunya yang tetap terlihat saat panel dikecilkan -->
            <TextView
                android:id="@+id/tvCurrentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to accept bookings..."
                android:textAlignment="center"
                android:textColor="#D32F2F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstimationInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAlignment="center"
                android:textColor="#757575"
                android:textSize="13sp" />

            <!-- 🚑 Info Penumpang: supaya driver bisa konfirmasi penumpang saat bertemu -->
            <LinearLayout
                android:id="@+id/layoutPassengerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivPassengerPhoto"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/foto_profil"
                    app:civ_border_color="#80FF624E"
                    app:civ_border_width="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPassengerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Passenger Name"
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPassengerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnCallPassenger"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="#2E7D32"
                    android:contentDescription="Call Passenger"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- 🚑 Stepper progres perjalanan: pembacaan visual dari status booking yang sudah
                 dilacak listener yang ada, bukan sumber data baru. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/stepCircle1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_step_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pickup"
                        android:textColor="#757575"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:id="@+id/stepConnector1"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="14dp"
                    android:background="#E0E0E0" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/stepCircle2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_step_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="To Hospital"
                        android:textColor="#757575"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:id="@+id/stepConnector2"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="14dp"
                    android:background="#E0E0E0" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/stepCircle3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_step_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Done"
                        android:textColor="#757575"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSelesai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Confirm Pickup"
                android:backgroundTint="#D32F2F"
                android:textColor="@android:color/white"
                android:padding="12dp"
                android:textAllCaps="false"
                android:visibility="gone" />

            <!-- Hanya muncul saat mode "antar" (sudah menjemput pasien, menuju RS) - driver
                 dianggap punya kapabilitas menilai kegawatdaruratan pasien & bisa mengalihkan
                 tujuan ke RS lain yang fasilitasnya lebih lengkap kalau kondisinya mendesak. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGantiRumahSakit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="@color/pink_pale"
                android:text="Change to Another Hospital (Emergency)"
                android:textAllCaps="false"
                android:textColor="@color/pink_main"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Sengaja dibuat teks polos (bukan tombol merah besar) supaya tidak gampang
                 tersenggol tidak sengaja - dipakai HANYA untuk keadaan darurat di tengah
                 perjalanan (kecelakaan, ban bocor, dll), butuh 2x konfirmasi sebelum benar-benar
                 membatalkan (lihat ActivityDriveFragmentDriver.kt). -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBatalkanPesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:text="Cancel Booking (Emergency)"
                android:textAllCaps="false"
                android:textColor="#D32F2F"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
