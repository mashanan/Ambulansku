<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Passenger Home (Figma: P06 Home).
     Coral header (greeting + avatar) -> floating emergency card (main CTA) -> service tiles -> about.
     View IDs used by HomeFragment.kt are kept: textView2, textView3, profile_image,
     cardMiniRight (Call Ambulance), cardMiniLeft (Hospitals), cardMenu (First Aid). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header + overlapping CTA card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_v2_header_gradient"
                android:fitsSystemWindows="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="96dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Greeting, set by HomeFragment.getGreeting() -->
                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"
                            android:text="Good Morning,"
                            android:textAppearance="@style/TextAppearance.V2.Body"
                            android:textColor="@color/v2_text_on_brand" />

                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="User"
                            android:textAppearance="@style/TextAppearance.V2.H1"
                            android:textColor="@color/v2_text_on_brand" />
                    </LinearLayout>

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profile_image"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="Profile photo"
                        android:src="@drawable/foto_profil"
                        app:civ_border_color="@color/v2_text_on_brand"
                        app:civ_border_width="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Emergency CTA: the one thing users look for in an emergency -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.V2.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="120dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.V2.IconBox"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:backgroundTint="@color/v2_danger_soft"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_v2_alert"
                            app:tint="@color/v2_danger" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textView4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Medical emergency?"
                                android:textAppearance="@style/TextAppearance.V2.H2" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="We find the nearest ambulance and hospital for you."
                                android:textAppearance="@style/TextAppearance.V2.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cardMiniRight"
                        style="@style/Widget.V2.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Call Ambulance Now"
                        app:icon="@drawable/ic_v2_ambulance" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:text="What you need"
            android:textAppearance="@style/TextAppearance.V2.H3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMiniLeft"
                style="@style/Widget.V2.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imagerumahsakit"
                        style="@style/Widget.V2.IconBox"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_v2_hospital" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Hospitals"
                        android:textAppearance="@style/TextAppearance.V2.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Choose a destination"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMenu"
                style="@style/Widget.V2.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imageambulans"
                        style="@style/Widget.V2.IconBox"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_v2_first_aid" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="First Aid"
                        android:textAppearance="@style/TextAppearance.V2.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Steps while you wait"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:text="About Ambulansku"
            android:textAppearance="@style/TextAppearance.V2.H3" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAboutUs"
            style="@style/Widget.V2.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/v2_info_soft"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_v2_info"
                    app:tint="@color/v2_info" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="Ambulansku connects you with the nearest ambulance driver for medical emergencies. Book an ambulance, track your driver in real time, and get to your destination hospital without a long wait."
                    android:textAppearance="@style/TextAppearance.V2.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
