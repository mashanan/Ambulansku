<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Welcome Driver (same pattern as passenger P03). Coral hero with logo, headline, Sign In + Sign Up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_surface"
    android:orientation="vertical"
    tools:context=".ForDriver.Welcome.MainActivityDriver">

    <FrameLayout
        android:id="@+id/backgroundmainImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_v2_header_gradient"
        android:fitsSystemWindows="true">

        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_v2_splash_ring" />

        <View
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_v2_splash_ring" />

        <ImageView
            android:id="@+id/imageLoginIcon"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_v2_circle"
            android:contentDescription="Ambulance"
            android:elevation="4dp"
            android:padding="28dp"
            android:src="@drawable/ic_v2_ambulance"
            app:tint="@color/v2_brand" />

        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_v2_pill"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Verified ambulance drivers"
            android:textAppearance="@style/TextAppearance.V2.Caption"
            android:textColor="@color/v2_text_primary"
            app:drawableStartCompat="@drawable/ic_v2_shield_check"
            app:drawableTint="@color/v2_brand" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver partner"
            android:textAppearance="@style/TextAppearance.V2.Overline"
            android:textColor="@color/v2_brand" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Be there when it matters"
            android:textAppearance="@style/TextAppearance.V2.Display" />

        <TextView
            android:id="@+id/tvLoginTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Receive nearby emergency bookings, navigate with live traffic, and keep patients updated."
            android:textAppearance="@style/TextAppearance.V2.Body.Secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonsignindriver"
            style="@style/Widget.V2.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Sign In" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonsignupdriver"
            style="@style/Widget.V2.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Register as a driver" />
    </LinearLayout>
</LinearLayout>
