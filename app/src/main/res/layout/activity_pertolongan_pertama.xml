<?xml version="1.0" encoding="utf-8"?>
<!-- v2 First Aid list (passenger). IDs unchanged (PertolonganPertamaActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/v2_bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.V2.CircleButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_v2_arrow_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="First Aid"
            android:textAppearance="@style/TextAppearance.V2.H2" />
    </LinearLayout>

    <TextView
        android:id="@+id/cardDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_v2_round_md"
        android:backgroundTint="@color/v2_warning_soft"
        android:drawablePadding="10dp"
        android:padding="12dp"
        android:text="General information, not a substitute for professional medical care. In an emergency, call an ambulance first."
        android:textAppearance="@style/TextAppearance.V2.Caption"
        android:textColor="@color/v2_warning"
        app:drawableStartCompat="@drawable/ic_v2_alert"
        app:drawableTint="@color/v2_warning" />

    <EditText
        android:id="@+id/etSearchFirstAid"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_v2_pill_outline"
        android:drawablePadding="10dp"
        android:hint="Search condition or symptom (e.g. chest pain)"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textAppearance="@style/TextAppearance.V2.Body"
        android:textColorHint="@color/v2_text_tertiary"
        app:drawableStartCompat="@drawable/ic_v2_search"
        app:drawableTint="@color/v2_text_tertiary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFirstAid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/layoutEmptyFirstAid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_v2_circle"
                android:backgroundTint="@color/v2_bg_subtle"
                android:importantForAccessibility="no"
                android:padding="20dp"
                android:src="@drawable/ic_v2_search"
                app:tint="@color/v2_text_tertiary" />

            <TextView
                android:id="@+id/tvEmptyFirstAid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No matching conditions found"
                android:textAppearance="@style/TextAppearance.V2.H3" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
