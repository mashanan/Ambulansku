<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Baris Atas: Label, Tag Utama, Favorit & Edit -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Home"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Badge/Chip ALAMAT UTAMA -->
            <TextView
                android:id="@+id/tvPrimaryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="#E1F5FE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="PRIMARY"
                android:textColor="#0288D1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Tombol Bintang Favorit -->
            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="2dp"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="Favorite" />

            <!-- Tombol Edit (Tetap di Atas) -->
            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#757575"
                android:contentDescription="Edit Address" />
        </LinearLayout>

        <!-- Alamat Lengkap -->
        <TextView
            android:id="@+id/tvFullAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutHeader"
            android:layout_marginTop="6dp"
            android:text="Full address"
            android:textColor="#424242"
            android:textSize="14sp" />

        <!-- Catatan / Patokan -->
        <TextView
            android:id="@+id/tvNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvFullAddress"
            android:layout_marginTop="4dp"
            android:text="Note/Landmark"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="italic" />

        <!-- Baris Bawah: Tombol Set Utama (Kiri) & Tombol Hapus (Kanan Bawah) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvNote"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnSetPrimary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="Set as Primary Address"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/black"
                app:strokeColor="#D12F2F" />

            <!-- Tombol Hapus DIPINDAHKAN KE KANAN BAWAH -->
            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#D32F2F"
                android:contentDescription="Delete Address" />
        </RelativeLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>