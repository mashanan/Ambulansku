<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/v2_border_default"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvConditionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Condition Name"
            android:textAppearance="@style/TextAppearance.V2.H3" />

        <TextView
            android:id="@+id/tvConditionSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Symptoms"
            android:textColor="@color/v2_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvConditionStepCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0 first aid steps"
            android:textColor="@color/v2_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditFirstAid"
                style="@style/Widget.V2.Button.Secondary.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Edit"
                app:icon="@drawable/ic_v2_pencil" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteFirstAid"
                style="@style/Widget.V2.Button.Danger.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delete"
                app:icon="@drawable/ic_v2_trash" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
