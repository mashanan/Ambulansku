<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Admin Dashboard. IDs unchanged (HomeFragmentAdmin.kt). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_canvas"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:text="Admin"
            android:textAppearance="@style/TextAppearance.V2.Overline"
            android:textColor="@color/v2_brand" />

        <TextView
            android:id="@+id/tvAdminHomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="4dp"
            android:text="Dashboard"
            android:textAppearance="@style/TextAppearance.V2.H1" />

        <LinearLayout
            android:id="@+id/cardAdminStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_card"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ic_v2_users" />

                <TextView
                    android:id="@+id/tvStatUserCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="-"
                    android:textAppearance="@style/TextAppearance.V2.H1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Active users"
                    android:textAppearance="@style/TextAppearance.V2.Caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_card"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ic_v2_id_card" />

                <TextView
                    android:id="@+id/tvStatPendingDriver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="-"
                    android:textAppearance="@style/TextAppearance.V2.H1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pending drivers"
                    android:textAppearance="@style/TextAppearance.V2.Caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_card"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ic_v2_hospital" />

                <TextView
                    android:id="@+id/tvStatHospitalCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="-"
                    android:textAppearance="@style/TextAppearance.V2.H1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hospitals"
                    android:textAppearance="@style/TextAppearance.V2.Caption" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:text="Manage"
            android:textAppearance="@style/TextAppearance.V2.Overline" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardApproveDriver"
            style="@style/Widget.V2.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:backgroundTint="@color/v2_warning_soft"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_shield_check"
                    app:tint="@color/v2_warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Approve drivers"
                        android:textAppearance="@style/TextAppearance.V2.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Review qualification documents of new drivers"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_chevron_right"
                    app:tint="@color/v2_text_tertiary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardManageHospital"
            style="@style/Widget.V2.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:backgroundTint="@color/v2_info_soft"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_hospital"
                    app:tint="@color/v2_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hospitals"
                        android:textAppearance="@style/TextAppearance.V2.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Add, edit or remove destination hospitals"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_chevron_right"
                    app:tint="@color/v2_text_tertiary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardManageUsers"
            style="@style/Widget.V2.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:backgroundTint="@color/v2_brand_soft"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_users"
                    app:tint="@color/v2_brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Users"
                        android:textAppearance="@style/TextAppearance.V2.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Deactivate or reactivate passenger &amp; driver accounts"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_chevron_right"
                    app:tint="@color/v2_text_tertiary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardManageFirstAid"
            style="@style/Widget.V2.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:backgroundTint="@color/v2_danger_soft"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_first_aid"
                    app:tint="@color/v2_danger" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="First aid guides"
                        android:textAppearance="@style/TextAppearance.V2.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Add, edit or remove emergency first aid entries"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_chevron_right"
                    app:tint="@color/v2_text_tertiary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
