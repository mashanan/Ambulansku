<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Placeholder CardMenu sebagai anchor -->
    <View
        android:id="@+id/cardMenu"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CardView Kiri -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMiniLeft"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="10dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/cardMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardMiniRight"
        app:layout_constraintHorizontal_chainStyle="spread">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Gambar di kanan atas -->
            <ImageView
                android:id="@+id/imagerumahsakit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_margin="15dp"
                android:contentDescription="Hospital Icon"
                android:src="@drawable/ic_address" />

            <!-- Teks di kiri bawah -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="5dp"
                android:text="Select Hospital"
                android:textStyle="bold"
                android:textSize="14sp" />

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- CardView Kanan -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMiniRight"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/cardMenu"
        app:layout_constraintStart_toEndOf="@id/cardMiniLeft"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Gambar di kanan atas -->
            <ImageView
                android:id="@+id/imageambulans"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:contentDescription="Ambulance Icon"
                android:src="@drawable/ic_small_car" />

            <!-- Teks di kiri bawah -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:text="Call Ambulance"
                android:textStyle="bold"
                android:textSize="14sp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Kartu trip terakhir - hanya muncul kalau passenger sudah pernah punya trip completed.
         Dipindahkan dari Home ke sini (Layanan), di bawah Pilih Rumah Sakit/Panggil Ambulans. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLastTrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardMiniLeft">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Last Trip"
                android:textColor="#757575"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLastTripHospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="-"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastTripDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
