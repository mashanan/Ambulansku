<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Activity tab (Figma: P11 Activity, adapted to the data the app has today:
     quick actions + last completed trip). IDs unchanged (ActivityDriveFragment.kt). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_canvas"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Large top bar -->
        <LinearLayout
            android:id="@+id/cardMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/v2_bg_surface"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activity"
                android:textAppearance="@style/TextAppearance.V2.H1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Book an ambulance and see your trips"
                android:textAppearance="@style/TextAppearance.V2.Body.Secondary" />
        </LinearLayout>

        <!-- Main action -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMiniRight"
            style="@style/Widget.V2.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/v2_brand_soft"
            app:strokeColor="@color/v2_brand"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imageambulans"
                    style="@style/Widget.V2.IconBox"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/v2_brand"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_v2_ambulance"
                    app:tint="@color/v2_text_on_brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Call Ambulance"
                        android:textAppearance="@style/TextAppearance.V2.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Open the map and book the nearest driver"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_chevron_right"
                    app:tint="@color/v2_brand" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMiniLeft"
            style="@style/Widget.V2.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imagerumahsakit"
                    style="@style/Widget.V2.IconBox"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/v2_info_soft"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_v2_hospital"
                    app:tint="@color/v2_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select Hospital"
                        android:textAppearance="@style/TextAppearance.V2.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="See hospitals near you"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_chevron_right"
                    app:tint="@color/v2_text_tertiary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Last completed trip (only shown when there is one) -->
        <LinearLayout
            android:id="@+id/cardLastTrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:text="Your last trip"
                android:textAppearance="@style/TextAppearance.V2.Overline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_v2_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Widget.V2.IconBox"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/v2_info_soft"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_v2_hospital"
                    app:tint="@color/v2_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLastTripHospital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textAppearance="@style/TextAppearance.V2.BodyStrong" />

                    <TextView
                        android:id="@+id/tvLastTripDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="-"
                        android:textAppearance="@style/TextAppearance.V2.Caption" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.V2.Badge.Success"
                    android:text="Done" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
