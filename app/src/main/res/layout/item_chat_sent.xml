<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Chat Bubble / Sent. IDs unchanged (Chat/ChatAdapter.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingVertical="4dp"
    android:paddingStart="48dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/ivSentImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_v2_round_lg"
        android:backgroundTint="@color/v2_bg_subtle"
        android:clipToOutline="true"
        android:contentDescription="Photo"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSentMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_v2_bubble_sent"
        android:maxWidth="260dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Hello driver, where are you?"
        android:textAppearance="@style/TextAppearance.V2.Body"
        android:textColor="@color/v2_text_on_brand" />

    <TextView
        android:id="@+id/tvStatusRead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:text="Sent"
        android:textAppearance="@style/TextAppearance.V2.Caption"
        android:textColor="@color/v2_text_tertiary"
        android:textSize="11sp" />

</LinearLayout>
