<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_canvas"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_v2_divider_bottom"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_v2_circle"
            android:backgroundTint="@color/v2_bg_subtle"
            android:contentDescription="Back"
            android:padding="10dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_v2_arrow_left"
            app:tint="@color/v2_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnBack"
            android:text="Manage Hospitals"
            android:textAppearance="@style/TextAppearance.V2.H2" />
    </RelativeLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/v2_border_default"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <EditText
            android:id="@+id/etSearchHospital"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@null"
            app:drawableStartCompat="@drawable/ic_v2_search"
            app:drawableTint="@color/v2_text_tertiary"
            android:drawablePadding="12dp"
            android:hint="Search hospitals..."
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textAppearance="@style/TextAppearance.V2.Body"
            android:textColorHint="@color/v2_text_tertiary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Built-in hospital data import (assets/hospitals_jatim.json). Shown only when some
         entries are not in Firestore yet; see ManageHospitalActivity.updateImportCard(). -->
    <LinearLayout
        android:id="@+id/cardImportHospitals"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_v2_card_brand"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCard">

        <ImageView
            style="@style/Widget.V2.IconBox"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/v2_brand"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_v2_hospital"
            app:tint="@color/v2_text_on_brand" />

        <TextView
            android:id="@+id/tvImportHospitalsMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:text="East Java hospitals available to import"
            android:textAppearance="@style/TextAppearance.V2.Label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportHospitals"
            style="@style/Widget.V2.Button.Primary.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Import" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHospitalList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardImportHospitals" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddHospital"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="Add Hospital"
        android:src="@drawable/ic_v2_plus"
        app:backgroundTint="@color/pink_main"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
