<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Sign In Driver (same pattern as passenger P04). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_surface"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ForDriver.Welcome.SignInActivityDriver">

    <LinearLayout
        android:id="@+id/guideForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Driver sign in"
            android:textAppearance="@style/TextAppearance.V2.H1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sign in to go online and receive emergency bookings."
            android:textAppearance="@style/TextAppearance.V2.Body.Secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailLayout"
            style="@style/Widget.V2.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Email"
            app:startIconDrawable="@drawable/ic_v2_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailEt"
                style="@style/Widget.V2.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            style="@style/Widget.V2.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Password"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_v2_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passET"
                style="@style/Widget.V2.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Shown by SignInActivity when the email is not verified yet. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResendVerification"
            style="@style/Widget.V2.Button.Tertiary.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Resend verification email"
            android:visibility="gone"
            app:icon="@drawable/ic_v2_mail"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signinbutton"
            style="@style/Widget.V2.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Sign In" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Don't have an account? Sign Up"
            android:textAppearance="@style/TextAppearance.V2.BodyStrong"
            android:textColor="@color/v2_brand" />
    </LinearLayout>
</ScrollView>
