<?xml version="1.0" encoding="utf-8"?>
<!-- v2 Chat List Item (Figma component "Chat List Item"). IDs unchanged (PassengerChatAdapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_v2_divider_bottom"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_v2_circle"
        android:backgroundTint="@color/v2_brand_soft"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_v2_ambulance"
        app:tint="@color/v2_brand" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHospitalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Destination Hospital"
            android:textAppearance="@style/TextAppearance.V2.BodyStrong" />

        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Last message..."
            android:textAppearance="@style/TextAppearance.V2.Body.Secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChatStatus"
        style="@style/Widget.V2.Badge.Success"
        android:text="Ongoing" />
</LinearLayout>
