<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol aksi berbahaya (mis. Delete Account): garis merah tanpa isi, supaya tidak lebih
     mencolok dari tombol utama dan tidak gampang tertekan tanpa sengaja. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.5dp" android:color="@color/pink_button" />
    <corners android:radius="12dp" />
    <padding android:left="8dp" android:right="8dp" android:top="8dp" android:bottom="8dp" />
</shape>
