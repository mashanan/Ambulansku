<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- colorPrimary/Accent/Secondary sebelumnya tidak pernah di-override, jadi semua komponen
         Material tak berstyle (Button polos yg auto-inflate jadi MaterialButton, Switch,
         CheckBox, ProgressBar, dll) otomatis pakai palet ungu bawaan Material Components alih-alih
         tema merah-putih aplikasi ini. -->
    <!-- Parent sengaja ".Light" (BUKAN ".DayNight") - aplikasi ini tidak didesain untuk dark mode
         (semua warna background/teks di-hardcode, tidak ada values-night). Pakai DayNight bikin
         komponen yang mengikuti atribut tema (mis. garis kotak TextInputLayout OutlinedBox) ikut
         berubah warna saat sistem HP dark mode (umum di MIUI/HyperOS Xiaomi/Redmi), sementara
         background di sekitarnya tetap warna terang yang di-hardcode - hasilnya kotak input
         email/password jadi menyatu/tak terlihat di HP yang dark mode-nya aktif. -->
    <style name="Theme.TugasAkhirFinal" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/pink_main</item>
        <item name="colorPrimaryDark">@color/pink_main</item>
        <item name="colorAccent">@color/pink_main</item>
        <item name="colorSecondary">@color/pink_main</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Mematikan fitur "Force Dark" bawaan Android (API 29+) yang bisa membalik warna app
             secara paksa di level sistem - beberapa skin OEM (terutama HyperOS/MIUI) lebih agresif
             menerapkan ini dibanding Android murni, terlepas dari tema Light-only di atas. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/bg_splash_screen</item>
    </style>

    <style name="LoginTextInputOuterFieldStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginBottom">15dp</item>
    </style>

    <style name="LoginTextInputInnerFieldStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Tombol aksi sekunder (mis. "Choose License Photo" di form kualifikasi driver): bergaris
         oranye, sudut membulat, tidak kapital - sebelumnya pakai MaterialButton default (huruf
         kapital semua, sudut lancip) yang beda sendiri dari tombol lain di app. -->
    <style name="SecondaryOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pink_main</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/pink_main</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Sudut membulat cuma di atas, dipakai kartu bottom sheet (mis. panel info pesanan di
         ActivityDrive) supaya bagian bawahnya rata menyatu dengan tepi layar, bukan membulat
         semua sisi seperti CardView biasa. -->
    <style name="ShapeAppearance.BottomSheetTop" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>